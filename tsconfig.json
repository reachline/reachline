{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "reachline.ts",
    "cli/**/*.ts",
    "app/cli.vite.config.ts",
    "engine/**/*.ts",
    "server/**/*.ts",
    "e2e/**/*.ts",
    "test/**/*.ts"
  ]
}
