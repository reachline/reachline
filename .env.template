# Where users reach ReachLine, as an origin: https://reachline.example.com.
# Required: it decides whether the session cookie is Secure, and it's where the
# OpenID provider sends users back to.
PUBLIC_URL=

# Who the container runs as, and so who owns ./reachline-data.
# PUID=1000
# PGID=1000

# 1 lets anyone who reaches the page create an account, with a password or at
# their first sign-in with the OpenID provider; 0 closes registration. The first
# account can always be created.
# AUTH_REGISTRATION=1

# How users sign in: password, oidc, or both (password,oidc).
# AUTH_METHODS=password

# The OpenID Connect provider, when AUTH_METHODS includes oidc.
# AUTH_OIDC_ISSUER=
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# The provider's name, as in "Sign in with Authentik"; without one, "Sign in with SSO".
# AUTH_OIDC_LABEL=
# An image to show beside the provider's name, such as its logo's URL.
# AUTH_OIDC_ICON=

# 1 links a first sign-in with the provider to the account of the same
# username, if that account isn't linked yet; 0 always makes a new account.
# AUTH_OIDC_LINK_USERNAME=1

# How much the server logs: error, warn, info or debug. info records startup
# and every sign-in and account change; debug adds a line per request.
# LOG_LEVEL=info
