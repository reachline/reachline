# Copy to .env (or set these in the container's environment). Empty means the
# default. In development (`pnpm dev`) the server runs on 5200 behind Vite on
# 5199, and PORT and PUBLIC_URL here are ignored.

# Where users reach ReachLine, as an origin: https://reach.example.com. Plain
# http is allowed only for 127.0.0.1 and localhost; anywhere else, put a TLS
# reverse proxy in front.
PUBLIC_URL=

# The address and port to listen on. Default 127.0.0.1 and 5199; the Docker
# image listens on 0.0.0.0.
HOST=
PORT=

# Where the database lives. Default .dev/ in the repository, which holds
# example data only (`pnpm dev:reset` recreates it). Relative paths are
# relative to the repository.
DATA_DIR=

# 1 lets anyone who reaches the page create an account, with a password or at
# their first sign-in with the OpenID provider; 0 closes registration. The first
# account can always be created. Turn this off once your accounts exist.
AUTH_REGISTRATION=

# How users sign in: password, oidc, or both (password,oidc). Default password.
# Before turning passwords off, have every user link their account to the
# provider on their account page; an account with only a password is locked out.
AUTH_METHODS=

# The OpenID Connect provider, when AUTH_METHODS includes oidc. The issuer is
# exactly what the provider calls itself, trailing slash included (Authentik:
# https://auth.example.com/application/o/<slug>/). Register the redirect URI
# <PUBLIC_URL>/api/auth/oidc/callback with it. Leave the secret empty for a
# public client. The label is the sign-in button's text.
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_LABEL=
