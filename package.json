{
  "name": "reachline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "pnpm -r --parallel dev",
    "dev:reset": "node server/dev-reset.ts",
    "build": "pnpm --filter reachline-ui build",
    "start": "node --env-file-if-exists=.env server/main.ts",
    "reset-password": "node --env-file-if-exists=.env server/reset-password.ts",
    "check": "tsc -p . && pnpm --filter reachline-ui check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/*.test.ts\"",
    "verify": "pnpm check && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
