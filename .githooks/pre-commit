#!/bin/sh
# `pnpm install` points git here (core.hooksPath). Only the quick check: formatting
# of the staged files, as they are in the working tree. CI runs `pnpm verify`.
# Skip once with --no-verify.
git diff --cached --name-only -z --diff-filter=ACMR | xargs -0 -r pnpm exec prettier --check --ignore-unknown
